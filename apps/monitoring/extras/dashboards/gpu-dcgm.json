{
  "title": "GPU DCGM Overview",
  "uid": "gpu-dcgm-overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "GPU Utilization %",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "avg(DCGM_FI_DEV_GPU_UTIL) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "Memory Copy Utilization %",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "avg(DCGM_FI_DEV_MEM_COPY_UTIL) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "Encoder Utilization %",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "avg(DCGM_FI_DEV_ENC_UTIL) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "Decoder Utilization %",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "avg(DCGM_FI_DEV_DEC_UTIL) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "GPU Memory Used (MiB)",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
      "targets": [{"expr": "avg(DCGM_FI_DEV_FB_USED) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "GPU Memory Free (MiB)",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
      "targets": [{"expr": "avg(DCGM_FI_DEV_FB_FREE) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "GPU Memory Used %",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "100 * (avg(DCGM_FI_DEV_FB_USED) by (gpu)) / clamp_min((avg(DCGM_FI_DEV_FB_USED) by (gpu) + avg(DCGM_FI_DEV_FB_FREE) by (gpu)), 1)",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU Temperature (C)",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [{"expr": "avg(DCGM_FI_DEV_GPU_TEMP) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "GPU Power Usage (W)",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
      "targets": [{"expr": "avg(DCGM_FI_DEV_POWER_USAGE) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "GPU Power Limit (W)",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16},
      "targets": [{"expr": "avg(DCGM_FI_DEV_POWER_MGMT_LIMIT) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "Power Usage vs Limit %",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "100 * (avg(DCGM_FI_DEV_POWER_USAGE) by (gpu)) / clamp_min(avg(DCGM_FI_DEV_POWER_MGMT_LIMIT) by (gpu), 1)",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "SM Clock (MHz)",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
      "targets": [{"expr": "avg(DCGM_FI_DEV_SM_CLOCK) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "Memory Clock (MHz)",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 24},
      "targets": [{"expr": "avg(DCGM_FI_DEV_MEM_CLOCK) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "PCIe TX Throughput",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 24},
      "targets": [{"expr": "avg(DCGM_FI_DEV_PCIE_TX_THROUGHPUT) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "PCIe RX Throughput",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 24},
      "targets": [{"expr": "avg(DCGM_FI_DEV_PCIE_RX_THROUGHPUT) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "Total GPU Power (W)",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 24},
      "targets": [{"expr": "sum(DCGM_FI_DEV_POWER_USAGE)", "legendFormat": "Cluster Total"}]
    }
  ]
}
