{
  "title": "K8s + GPU Central",
  "uid": "k8s-gpu-central",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "query": "label_values(kube_pod_info, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": ".*"}
      },
      {
        "name": "pod",
        "type": "query",
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": ".*"}
      },
      {
        "name": "gpu",
        "type": "query",
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL, gpu)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": ".*"}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ready Nodes",
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})"}]
    },
    {
      "type": "stat",
      "title": "Running Pods (filtered)",
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Running\"})"}]
    },
    {
      "type": "stat",
      "title": "Cluster CPU Usage (cores)",
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}[5m]))"}]
    },
    {
      "type": "stat",
      "title": "Cluster Memory Usage (GiB)",
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}) / 1024 / 1024 / 1024"}]
    },
    {
      "type": "stat",
      "title": "Avg GPU Util % (filtered)",
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 0},
      "targets": [{"expr": "avg(DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"})"}]
    },
    {
      "type": "stat",
      "title": "GPU Power Total (W)",
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 0},
      "targets": [{"expr": "sum(DCGM_FI_DEV_POWER_USAGE{gpu=~\"$gpu\"})"}]
    },
    {
      "type": "gauge",
      "title": "GPU Workload Saturation Score",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 5},
      "targets": [
        {
          "expr": "100 * (0.5 * avg(DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"}) / 100 + 0.3 * (sum(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}) / clamp_min(sum(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"} + DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}), 1)) + 0.2 * avg(DCGM_FI_DEV_MEM_COPY_UTIL{gpu=~\"$gpu\"}) / 100)",
          "legendFormat": "Saturation"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pod CPU Usage Top 10 (cores)",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5},
      "targets": [
        {
          "expr": "topk(10, sum by (namespace,pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}[5m])))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pod Memory Usage Top 10 (GiB)",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "targets": [
        {
          "expr": "topk(10, sum by (namespace,pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}) / 1024 / 1024 / 1024)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "GPU Utilization by Device %",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 13},
      "targets": [{"expr": "avg(DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"}) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "bargauge",
      "title": "GPU Memory Used by Device %",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 13},
      "targets": [
        {
          "expr": "100 * (avg(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}) by (gpu)) / clamp_min((avg(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}) by (gpu) + avg(DCGM_FI_DEV_FB_FREE{gpu=~\"$gpu\"}) by (gpu)), 1)",
          "legendFormat": "GPU {{gpu}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "GPU Power by Device (W)",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 13},
      "targets": [{"expr": "avg(DCGM_FI_DEV_POWER_USAGE{gpu=~\"$gpu\"}) by (gpu)", "legendFormat": "GPU {{gpu}}"}]
    },
    {
      "type": "timeseries",
      "title": "Cluster CPU vs Avg GPU Util",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}[5m]))", "legendFormat": "CPU cores"},
        {"expr": "avg(DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"})", "legendFormat": "GPU util %"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Cluster Memory vs GPU Memory Used",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}) / 1024 / 1024 / 1024", "legendFormat": "K8s memory GiB"},
        {"expr": "sum(DCGM_FI_DEV_FB_USED{gpu=~\"$gpu\"}) / 1024", "legendFormat": "GPU memory GiB"}
      ]
    },
    {
      "type": "table",
      "title": "Selected Pod Snapshot (CPU cores)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {
          "expr": "topk(20, sum by (namespace,pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}[5m])))",
          "legendFormat": "{{namespace}}/{{pod}}",
          "instant": true
        }
      ]
    },
    {
      "type": "table",
      "title": "GPU Snapshot (Util/Power/Temp)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {"expr": "avg(DCGM_FI_DEV_GPU_UTIL{gpu=~\"$gpu\"}) by (gpu)", "legendFormat": "Util GPU {{gpu}}", "instant": true},
        {"expr": "avg(DCGM_FI_DEV_POWER_USAGE{gpu=~\"$gpu\"}) by (gpu)", "legendFormat": "Power GPU {{gpu}}", "instant": true},
        {"expr": "avg(DCGM_FI_DEV_GPU_TEMP{gpu=~\"$gpu\"}) by (gpu)", "legendFormat": "Temp GPU {{gpu}}", "instant": true}
      ]
    }
  ]
}
